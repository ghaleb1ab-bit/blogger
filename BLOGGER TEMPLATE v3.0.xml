<?xml version='1.0' encoding='UTF-8'?>
<widget>
  <head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <meta name='description' content='This is an updated blogger template with SEO optimized structure'>
    <meta name='keywords' content='blog, blogger, template'>
    <title>Blogger Template v3.0</title>
    <link rel='stylesheet' href='style.css'>
  </head>
  <body>
    <header>
      <h1>Welcome to My Blog</h1>
      <nav>
        <ul>
          <li><a href='#'>Home</a></li>
          <li><a href='#'>About</a></li>
          <li><a href='#'>Contact</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <section id='blog-posts'>
        <h2>Latest Blog Posts</h2>
        <article>
          <h3>Blog Post Title</h3>
          <p>This is a summary of the blog post.</p>
          <a href='#'>Read more...</a>
        </article>
      </section>
    </main>
    <aside>
      <h2>Sidebar</h2>
      <p>Links to archives and other interesting stuff.</p>
    </aside>
    <footer>
      <p>&copy; 2026 Your Blog Name</p>
    </footer>
  </body>
</widget>